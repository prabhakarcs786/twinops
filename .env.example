# TwinOps backend configuration.
# Copy to `.env` (git-ignored, excluded from the Docker image) and fill in what you need:
#   cp .env.example .env
# Loaded by `python -m twinops`, `python -m twinops.evaluation` and `python -m twinops.lab`.
# Variables already exported in your shell win over this file. Blank values are ignored (= use the default).
# Point to another file with TWINOPS_ENV_FILE=/path/to/file. On Cloud Run use Secret Manager, not a .env file.

# ---------------------------------------------------------------------------
# Planner: who proposes hypotheses and fixes. Deterministic code always judges.
# ---------------------------------------------------------------------------
# auto (default): use an LLM if one is configured below, otherwise the deterministic runbook
# llm | runbook
TWINOPS_PLANNER=
# auto (default) | gemini | vertex | ollama | openai | replay
#   auto picks: replay dir → GEMINI_API_KEY → Vertex AI → TWINOPS_OPENAI_BASE_URL → TWINOPS_OLLAMA_BASE_URL
TWINOPS_LLM_PROVIDER=
# Model name. Defaults: gemini/vertex → gemini-2.5-flash, ollama → qwen2.5:7b. Required for openai.
TWINOPS_LLM_MODEL=
# Per-call timeout in seconds (default 30; local models on CPU may need 120+)
TWINOPS_LLM_TIMEOUT_S=
# Model calls per incident before falling back to the runbook (default 14)
TWINOPS_LLM_MAX_CALLS=
# Gemini 2.5 thinking budget in tokens (default 0 = off, fastest)
TWINOPS_LLM_THINKING_BUDGET=

# --- Option A: Gemini API key (Google AI Studio) ---------------------------
GEMINI_API_KEY=

# --- Option B: Vertex AI (no key; uses `gcloud auth application-default login` or the service account) ---
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
# default europe-west1
GOOGLE_CLOUD_LOCATION=

# --- Option C: Ollama (local, no key) ---------------------------------------
#   ollama serve && ollama pull qwen2.5:7b
#   then set TWINOPS_LLM_PROVIDER=ollama (and optionally TWINOPS_LLM_MODEL)
# default http://127.0.0.1:11434/v1 (setting this also makes `auto` choose Ollama)
TWINOPS_OLLAMA_BASE_URL=

# --- Option D: any OpenAI-compatible endpoint (approved enterprise gateway, LM Studio, vLLM, llama.cpp) ---
#   LM Studio: TWINOPS_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
TWINOPS_OPENAI_BASE_URL=
TWINOPS_OPENAI_API_KEY=

# --- Record / replay (deterministic demos and audits) -----------------------
# Record every live model response to this folder…
TWINOPS_LLM_RECORD_DIR=
# …and replay it later without any model (implies TWINOPS_LLM_PROVIDER=replay under auto)
TWINOPS_LLM_REPLAY_DIR=

# ---------------------------------------------------------------------------
# Twin backend
# ---------------------------------------------------------------------------
# model (default, in-process) | emulated (Containerlab lab; run `python -m twinops.lab up` first)
TWINOPS_TWIN=
# default <repo>/lab
TWINOPS_LAB_DIR=

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# default 127.0.0.1 / 8000
HOST=
PORT=
# Serve the built UI from the API (e.g. frontend/dist)
TWINOPS_STATIC_DIR=
# Comma-separated origins allowed to call the API (default http://localhost:5173)
TWINOPS_CORS_ORIGINS=
# Passcode required to approve/reject and to inject drift. Leave blank for open local demos.
TWINOPS_OPERATOR_TOKEN=
# Demo harness endpoints such as drift (default true)
TWINOPS_HARNESS=
# default 4 concurrent incidents / 10 new incidents per client per minute
TWINOPS_MAX_ACTIVE_RUNS=
TWINOPS_RATE_LIMIT_PER_MIN=
# Evaluation reports and SQLite incident evidence (default backend/.data).
# Use a persistent local disk for history across restarts; one service process only.
TWINOPS_DATA_DIR=

# Optional API key file, resolved relative to the repository root. Never served to browsers.
GEMINI_API_KEY_FILE=
# Connected demo: npm run dev:connected supplies these automatically to both processes.
# TWINOPS_NETWORK_URL=http://127.0.0.1:8010
# TWINOPS_NETWORK_TOKEN=<shared connector secret>
# TWINOPS_NETWORK_PORT=8010
# TWINOPS_UI_URL=http://localhost:5173
# TWINOPS_NETWORK_DATA=local-app/.data/state.json
# Optional management ranges when the default 172.30.10/24 and 172.30.11/24 overlap another Docker project:
# TWINOPS_LAB_PROD_SUBNET=10.253.10.0/24
# TWINOPS_LAB_TWIN_SUBNET=10.253.11.0/24
